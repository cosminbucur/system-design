                <mxCell id="12" value="&lt;p style=&quot;margin: 0in ; font-family: &amp;#34;calibri&amp;#34; ; font-size: 11.0pt&quot;&gt;&lt;b&gt;# merge changes from another branch&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin: 0in ; font-family: &amp;#34;calibri&amp;#34; ; font-size: 11.0pt&quot;&gt;&lt;span style=&quot;font-size: 11pt&quot;&gt;on feature-branch&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin: 0in ; font-family: &amp;#34;calibri&amp;#34; ; font-size: 11.0pt&quot;&gt;&amp;nbsp; &amp;nbsp;&lt;b&gt; # bring changes from remote develop to current feature branch&lt;/b&gt;&lt;/p&gt;&lt;span style=&quot;font-family: &amp;#34;calibri&amp;#34; ; font-size: 11pt&quot;&gt;&amp;nbsp; &amp;nbsp; idea: git fetch&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family: &amp;#34;calibri&amp;#34; ; font-size: 11pt&quot;&gt;&amp;nbsp; &amp;nbsp; idea: hover origin/develop &amp;gt; merge into&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-family: &amp;#34;calibri&amp;#34; ; font-size: 11pt&quot;&gt;current&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;font-family: &amp;#34;calibri&amp;#34; ; font-size: 11pt&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;p style=&quot;margin: 0in ; font-family: &amp;#34;calibri&amp;#34; ; font-size: 11.0pt&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;b&gt;# push local changes to remote develop&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin: 0in ; font-family: &amp;#34;calibri&amp;#34; ; font-size: 11.0pt&quot;&gt;&amp;nbsp; &amp;nbsp; idea: git commit&lt;/p&gt;&lt;p style=&quot;margin: 0in ; font-family: &amp;#34;calibri&amp;#34; ; font-size: 11.0pt&quot;&gt;&amp;nbsp; &amp;nbsp; idea: git push feature-branch&lt;/p&gt;&lt;p style=&quot;margin: 0in ; font-family: &amp;#34;calibri&amp;#34; ; font-size: 11.0pt&quot;&gt;&lt;/p&gt;&lt;br&gt;&lt;p style=&quot;margin: 0in ; font-family: &amp;#34;calibri&amp;#34; ; font-size: 11.0pt&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;b&gt;# merge remote feature-branch in remote develop&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin: 0in ; font-family: &amp;#34;calibri&amp;#34; ; font-size: 11.0pt&quot;&gt;&amp;nbsp; &amp;nbsp; github: create pull request &amp;gt; from remote feature-branch to remote develop&lt;/p&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingTop=-6;" parent="1" vertex="1">
                    <mxGeometry x="30" y="930" width="480" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="13" value="&lt;p style=&quot;margin: 0in ; font-family: &amp;#34;calibri&amp;#34; ; font-size: 11.0pt&quot;&gt;&lt;/p&gt;&lt;span style=&quot;white-space: nowrap&quot;&gt;&lt;b&gt;# get remote changes&lt;/b&gt;&lt;/span&gt;&lt;br style=&quot;white-space: nowrap&quot;&gt;&lt;span style=&quot;white-space: nowrap&quot;&gt;&amp;nbsp; &amp;nbsp;&lt;i&gt; git fetch&lt;/i&gt; (brings all branches with&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;white-space: nowrap&quot;&gt;changes)&lt;/span&gt;&lt;br style=&quot;white-space: nowrap&quot;&gt;&lt;span style=&quot;white-space: nowrap&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;i&gt;git pull&lt;/i&gt; (downloads changes)&lt;/span&gt;&lt;span style=&quot;font-family: &amp;#34;calibri&amp;#34; ; font-size: 11pt&quot;&gt;&lt;br&gt;&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingTop=-6;" parent="1" vertex="1">
